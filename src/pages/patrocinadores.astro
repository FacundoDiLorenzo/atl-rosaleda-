---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { src } from '../lib/img';
import { PATROCINADORES } from '../data/patrocinadores';
---
<Base title="Patrocinadores" description="Empresas que apoyan al Atlético Rosaleda FS y el deporte base en Málaga. Descubre cómo patrocinar al club y conectar con cientos de familias.">
  <PageHero
    eyebrow="Gracias por creer en nosotros"
    title="Patrocinadores"
    lead="Impulsa el deporte local y haz crecer tu marca junto a nosotros. Conecta cada semana con familias, jugadores y afición."
  >
    <a class="btn btn--primary" href={u('/contacto/')}>Quiero patrocinar <Icon name="arrow" class="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <ul class="sp">
        {PATROCINADORES.map((p, i) => (
          <li class="sp__card" data-reveal style={`--i:${i % 3}`}>
            <div class="sp__logo">
              <img src={src(p.logo, 320)} srcset={`${src(p.logo, 320)} 1x, ${src(p.logo, 640)} 2x`} alt={`Logotipo de ${p.nombre}`} width="160" height="160" loading="lazy" />
            </div>
            <div class="sp__body">
              <h2 class="sp__t">{p.nombre}</h2>
              <p>{p.descripcion}</p>
              <ul class="sp__contact">
                {p.web && <li><a href={p.web} target="_blank" rel="noopener sponsored">{p.web.replace('https://', '')}</a></li>}
                {p.telefono && <li><Icon name="phone" size={16} /> {p.telefono.split(' · ').map((t, j) => <>{j > 0 && ' · '}<a href={`tel:+34${t.replace(/\s/g, '')}`}>{t}</a></>)}</li>}
                {p.email && <li><Icon name="mail" size={16} /> <a href={`mailto:${p.email}`}>{p.email}</a></li>}
                {p.direccion && <li><Icon name="pin" size={16} /> {p.direccion}</li>}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap pitch">
      <div class="stack">
        <p class="eyebrow" data-reveal>Patrocina al club</p>
        <h2 data-reveal style="--i:1">Tu marca, en la pista y en el barrio</h2>
      </div>
      <ul class="pitch__list">
        <li data-reveal><strong>Visibilidad semanal</strong> ante más de 300 jugadores y sus familias.</li>
        <li data-reveal style="--i:1"><strong>Presencia en redes</strong>: mención en las previas de partido de Instagram.</li>
        <li data-reveal style="--i:2"><strong>Ficha en esta web</strong> con tu logotipo, descripción y contacto.</li>
        <li data-reveal style="--i:3"><strong>Impacto social real</strong> en el deporte base, femenino e inclusivo de Málaga.</li>
      </ul>
      <a class="btn btn--primary" href={u('/contacto/')} data-reveal>Hablemos <Icon name="arrow" class="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  .sp { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .sp__card { display: grid; gap: var(--s-5); align-content: start; padding: var(--s-6); border-radius: var(--radius-lg); background: var(--paper-2); }
  .sp__logo { width: 7rem; aspect-ratio: 1; background: var(--paper); border-radius: var(--radius); display: grid; place-items: center; padding: var(--s-2); }
  .sp__logo img { width: 100%; height: 100%; object-fit: contain; }
  .sp__body { display: grid; gap: var(--s-3); }
  .sp__t { font-size: var(--step-2); }
  .sp__body > p { color: var(--ink-soft); font-size: var(--step--1); }
  .sp__contact { list-style: none; padding: 0; display: grid; gap: var(--s-1); font-size: var(--step--1); }
  .sp__contact li { display: flex; gap: var(--s-2); align-items: center; flex-wrap: wrap; }
  .sp__contact a { color: var(--naranja-text); font-weight: 600; text-decoration: none; word-break: break-all; }
  @media (hover: hover) and (pointer: fine) { .sp__contact a:hover { text-decoration: underline; } }
  .pitch { display: grid; gap: var(--s-6); justify-items: start; }
  .pitch__list { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); width: 100%; }
  .pitch__list li { border-top: 2px solid var(--naranja); padding-top: var(--s-4); color: oklch(0.85 0.01 75); }
  .pitch__list strong { color: var(--paper); display: block; font-size: var(--step-1); }
</style>
