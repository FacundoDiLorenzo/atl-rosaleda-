---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { EQUIPOS } from '../data/equipos';
import { PARTIDOS } from '../data/partidos';
import { REDES } from '../config';

const nombreEquipo = (slug: string | null) => (slug ? EQUIPOS.find((e) => e.slug === slug)?.corto : null) ?? 'Atlético Rosaleda';
const ahora = new Date();
const proximos = PARTIDOS.filter((p) => new Date(p.fecha) >= ahora).sort((a, b) => +new Date(a.fecha) - +new Date(b.fecha));
const jugados = PARTIDOS.filter((p) => new Date(p.fecha) < ahora).sort((a, b) => +new Date(b.fecha) - +new Date(a.fecha));
const dia = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
const hora = (iso: string) => new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
const federados = EQUIPOS.filter((e) => e.competicion);
---
<Base title="Competición" description="Calendario y resultados del Atlético Rosaleda FS: 2ª Andaluza, liga autonómica y provincial juvenil, ligas de asociación y Liga Municipal de Málaga.">
  <PageHero
    eyebrow="Temporada 2026/27"
    title="Competición"
    lead="Competimos para crecer y jugamos para dejar huella. Pasión, esfuerzo y compromiso en cada partido."
    image="2026/06/600_9415-1-e1781633075988-980x1024.jpg"
    imageAlt="Jugador del Atlético Rosaleda conduciendo el balón en un partido"
  />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <p class="eyebrow" data-reveal>Calendario</p>
          <h2 data-reveal style="--i:1">{proximos.length ? 'Próximos partidos' : 'Últimos partidos'}</h2>
        </div>
        <p class="lead" data-reveal style="--i:2">La previa de cada jornada se publica en <a class="accent" href={REDES.instagram.url} target="_blank" rel="noopener">Instagram</a>. ¡Te esperamos en la grada!</p>
      </div>

      {[...proximos, ...jugados].length === 0 ? (
        <p>Aún no hay partidos cargados para esta temporada.</p>
      ) : (
        <ol class="matches">
          {[...proximos, ...jugados].map((p, i) => (
            <li class="match" data-reveal style={`--i:${i}`}>
              <div class="match__date">
                <span class="match__d">{dia(p.fecha)}</span>
                <span class="num">{hora(p.fecha)}</span>
              </div>
              <div class="match__teams">
                <p class="match__comp">{p.competicion ?? nombreEquipo(p.equipo)}</p>
                <p class="match__vs">
                  {p.local ? <><strong>Atl. Rosaleda</strong> <span>vs</span> {p.rival}</> : <>{p.rival} <span>vs</span> <strong>Atl. Rosaleda</strong></>}
                </p>
                <p class="match__where"><Icon name="pin" size={16} /> {p.pabellon}</p>
              </div>
              <div class="match__res">
                {p.resultado ? <span class="display num">{p.resultado}</span> : new Date(p.fecha) >= ahora ? <span class="chip">{p.local ? 'En casa' : 'Fuera'}</span> : <span class="match__pending">Resultado pendiente</span>}
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap">
      <div class="section-head">
        <div class="stack">
          <p class="eyebrow" data-reveal>Dónde competimos</p>
          <h2 data-reveal style="--i:1">Ligas de la temporada</h2>
        </div>
        <p class="lead" data-reveal style="--i:2">El primer equipo y los juveniles federados juegan como locales en el Pabellón Forus Trinidad.</p>
      </div>
      <ul class="leagues">
        {federados.map((e, i) => (
          <li data-reveal style={`--i:${i % 6}`}>
            <a href={u(`/equipos/${e.slug}/`)}>
              <span class="leagues__team">{e.corto}</span>
              <span class="leagues__comp">{e.competicion}</span>
              <Icon name="arrow" class="leagues__go" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .matches { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .match {
    display: grid; gap: var(--s-3) var(--s-5); align-items: center;
    grid-template-columns: 5.5rem 1fr; padding: var(--s-5); border-radius: var(--radius-lg); background: var(--paper-2);
  }
  @media (min-width: 40rem) { .match { grid-template-columns: 7rem 1fr auto; } }
  .match__date { display: grid; font-size: var(--step--1); color: var(--ink-soft); }
  .match__d { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); text-transform: uppercase; color: var(--ink); line-height: 1; }
  .match__comp { font-size: var(--step--1); color: var(--naranja-text); font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em; }
  .match__vs { font-size: var(--step-1); line-height: 1.3; }
  .match__vs span { color: var(--ink-soft); font-size: 0.8em; margin-inline: 0.25em; }
  .match__where { display: flex; gap: var(--s-1); align-items: center; font-size: var(--step--1); color: var(--ink-soft); }
  .match__res { grid-column: 2; }
  @media (min-width: 40rem) { .match__res { grid-column: auto; text-align: right; } }
  .match__res .display { font-size: var(--step-3); }
  .match__pending { font-size: var(--step--1); color: var(--ink-soft); }
  .leagues { list-style: none; padding: 0; border-top: 1px solid var(--line-dark); }
  .leagues a {
    display: grid; grid-template-columns: 1fr auto; gap: var(--s-1) var(--s-5); align-items: center;
    padding: var(--s-5) 0; border-bottom: 1px solid var(--line-dark); text-decoration: none;
  }
  @media (min-width: 48rem) { .leagues a { grid-template-columns: 16rem 1fr auto; } }
  .leagues__team { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-2); line-height: 1; }
  .leagues__comp { color: oklch(0.8 0.012 75); grid-column: 1; }
  @media (min-width: 48rem) { .leagues__comp { grid-column: auto; } }
  :global(.leagues__go) { grid-row: 1 / span 2; grid-column: 2; transition: transform var(--dur-ui) var(--ease-out); color: var(--naranja); }
  @media (min-width: 48rem) { :global(.leagues__go) { grid-row: auto; grid-column: auto; } }
  @media (hover: hover) and (pointer: fine) {
    .leagues a:hover .leagues__team { color: var(--naranja); }
    .leagues a:hover :global(.leagues__go) { transform: translateX(4px); }
  }
</style>
