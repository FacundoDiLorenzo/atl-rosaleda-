---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details class="faq__item" data-reveal style={`--i:${i}`}>
      <summary>
        <span>{it.q}</span>
        <span class="faq__icon"><Icon name="plus" /></span>
      </summary>
      <div class="faq__a"><p>{it.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .on-dark .faq, .on-dark .faq__item { border-color: var(--line-dark); }
  summary {
    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
    padding: var(--s-5) 0; cursor: pointer; font-size: var(--step-1); font-weight: 600; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .faq__icon {
    flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    background: var(--paper-2); transition: transform 300ms var(--ease-out), background-color var(--dur-ui) ease;
  }
  .on-dark .faq__icon { background: var(--ink-2); }
  details[open] .faq__icon { transform: rotate(45deg); background: var(--naranja); color: var(--ink); }
  .faq__a { padding-bottom: var(--s-5); color: var(--ink-soft); }
  .on-dark .faq__a { color: oklch(0.82 0.012 75); }
  /* Apertura animada donde el navegador lo soporta (::details-content); si no, abre al instante. */
  .faq__item::details-content {
    block-size: 0; overflow: clip;
    transition: block-size 320ms var(--ease-out), content-visibility 320ms allow-discrete;
  }
  .faq__item[open]::details-content { block-size: auto; }
  @media (hover: hover) and (pointer: fine) {
    summary:hover .faq__icon { background: var(--naranja-wash); }
    .on-dark summary:hover .faq__icon { background: var(--line-dark); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content { transition: none; }
  }
</style>
