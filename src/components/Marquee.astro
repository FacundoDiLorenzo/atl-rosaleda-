---
import { LEMAS } from '../data/contenido';
---
<div class="mq" aria-label={LEMAS.join('. ')} role="marquee">
  <div class="mq__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul>
        {LEMAS.map((l) => <li>{l}<span class="mq__dot">●</span></li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .mq { overflow: hidden; background: var(--naranja); color: var(--ink); padding-block: var(--s-4); }
  .mq__track { display: flex; width: max-content; animation: mq 48s linear infinite; }
  .mq ul { display: flex; list-style: none; padding: 0; flex: none; }
  .mq li {
    display: flex; align-items: center; gap: var(--s-5); padding-right: var(--s-5); max-width: none;
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-2); line-height: 1; white-space: nowrap;
  }
  .mq__dot { font-size: 0.5em; }
  @media (hover: hover) and (pointer: fine) { .mq:hover .mq__track { animation-play-state: paused; } }
  @keyframes mq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .mq__track { animation: none; } }
</style>
