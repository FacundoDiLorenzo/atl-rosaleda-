---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';
import type { Equipo } from '../data/equipos';
interface Props { equipo: Equipo; i?: number; }
const { equipo: e, i = 0 } = Astro.props;
---
<a class="tc" href={u(`/equipos/${e.slug}/`)} data-reveal style={`--i:${i}`}>
  <div class="tc__media">
    {e.foto && <Img path={e.foto} alt={`Equipo ${e.corto} del Atlético Rosaleda`} sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 90vw" max={960} />}
  </div>
  <div class="tc__body">
    <div class="tc__meta">
      {e.anios && <span class="num">{e.anios}</span>}
      {e.captacion && <span class="chip">Plazas abiertas</span>}
    </div>
    <h3 class="tc__t">{e.corto}</h3>
    <span class="tc__go" aria-hidden="true"><Icon name="arrow" /></span>
  </div>
</a>

<style>
  .tc { position: relative; display: grid; text-decoration: none; border-radius: var(--radius-lg); overflow: hidden; background: var(--ink); color: var(--paper); isolation: isolate; }
  .tc:active { transform: scale(0.985); transition: transform var(--dur-press) var(--ease-out); }
  .tc__media { aspect-ratio: 4 / 5; grid-area: 1 / 1; }
  .tc__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .tc__body {
    grid-area: 1 / 1; align-self: end; position: relative; z-index: 1;
    padding: var(--s-5); display: grid; gap: var(--s-2);
    background: linear-gradient(to top, oklch(0.18 0.012 60 / 0.92) 10%, oklch(0.18 0.012 60 / 0) 100%);
    padding-top: var(--s-9);
  }
  .tc__meta { display: flex; gap: var(--s-2); align-items: center; flex-wrap: wrap; font-size: var(--step--1); color: oklch(0.85 0.01 75); }
  .tc .chip { background: var(--naranja); color: var(--ink); }
  .tc__t { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-3); line-height: 0.95; padding-right: var(--s-7); }
  .tc__go {
    position: absolute; right: var(--s-5); bottom: var(--s-5);
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    background: var(--paper); color: var(--ink);
    transition: transform var(--dur-ui) var(--ease-out), background-color var(--dur-ui) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .tc:hover .tc__media :global(img) { transform: scale(1.04); }
    .tc:hover .tc__go { background: var(--naranja); transform: translateX(2px) rotate(-45deg); }
  }
</style>
