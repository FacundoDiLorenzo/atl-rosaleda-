---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { title: string; description: string; updated: string; }
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <PageHero eyebrow="Información legal" title={title} lead={`Última actualización: ${updated}`} />
  <section class="section">
    <div class="wrap legal prose"><slot /></div>
  </section>
</Base>
<style>.legal { max-width: 46rem; }</style>
