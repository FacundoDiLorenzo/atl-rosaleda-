# Copiá este archivo a .env y completá lo que uses.
# Servicio que recibe el formulario (p. ej. https://api.web3forms.com/submit). Vacío = abre el correo.
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=
# Clave pública de Cloudflare Turnstile (antispam opcional)
PUBLIC_TURNSTILE_SITE_KEY=
# Al desplegar fuera del dominio principal
SITE_URL=https://atleticorosaleda.com
BASE_PATH=/
